// emit-c smoke against stubs/ (no ESP-IDF).
import "../../esp_wifi" wifi

fn main() {
  let _h = wifi.sta_set_hostname("klin-wifi")
  let _s = wifi.sta_set_static_ip(
    wifi.ipv4(192, 168, 1, 50),
    wifi.ipv4(192, 168, 1, 1),
    wifi.ipv4(255, 255, 255, 0)
  )
  let mut e = wifi.sta_init()
  if e != wifi.err_ok() {
    return
  }

  // Scan (W2) — after sta_init; SSID into caller buffer.
  e = wifi.scan_start(1000)
  if e != wifi.err_ok() {
    return
  }
  let _max = wifi.scan_max()
  if wifi.scan_count() < 1 {
    return
  }
  let mut ssid: [33]u8
  let _nl = wifi.scan_ssid(0, cast(*mut u8, &ssid[0]), 33)
  let _r = wifi.scan_rssi(0)
  let _ch = wifi.scan_channel(0)
  let _am = wifi.scan_authmode(0)
  wifi.scan_log()

  e = wifi.sta_connect("test", "pass")
  if e != wifi.err_ok() {
    return
  }
  e = wifi.sta_wait_connected(1000)
  if e != wifi.err_ok() {
    return
  }
  if !wifi.sta_connected() {
    return
  }
  e = wifi.sta_wait_ip(1000)
  if e != wifi.err_ok() {
    return
  }
  if wifi.sta_ip_u32() == 0 {
    return
  }
  if wifi.sta_gateway_u32() == 0 {
    return
  }
  if wifi.sta_netmask_u32() == 0 {
    return
  }
  wifi.sta_log_ip()
  wifi.sta_log_ip_info()
  // Link stats after assoc (W3).
  let _lr = wifi.sta_rssi()
  let _lch = wifi.sta_channel()
  let _lam = wifi.sta_authmode()
  let mut apssid: [33]u8
  let _aln = wifi.sta_ap_ssid(cast(*mut u8, &apssid[0]), 33)
  wifi.sta_log_link()

  // SoftAP surface (do not mix with STA on hardware in one binary).
  e = wifi.ap_init()
  if e != wifi.err_ok() {
    return
  }
  e = wifi.ap_start("klin-ap", "klinpass1", 6)
  if e != wifi.err_ok() {
    return
  }
  e = wifi.ap_wait_started(1000)
  if e != wifi.err_ok() {
    return
  }
  if !wifi.ap_started() {
    return
  }
  let _n = wifi.ap_station_num()
  wifi.ap_log_ip()
  wifi.ap_log_ip_info()
  let _v = wifi.version()
}
