// emit-c smoke against stubs/ (no ESP-IDF).
import "../../esp_wifi" wifi

fn main() {
  let mut e = wifi.sta_init()
  if e != wifi.err_ok() {
    return
  }
  e = wifi.sta_connect("test", "pass")
  if e != wifi.err_ok() {
    return
  }
  e = wifi.sta_wait_ip(1000)
  if e != wifi.err_ok() {
    return
  }
  let ip = wifi.sta_ip_u32()
  if ip == 0 {
    return
  }
  wifi.sta_log_ip()
  let _v = wifi.version()
}
